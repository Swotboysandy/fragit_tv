<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- frag: focus is a brighter pane of glass with a light rim, not a white slab (OLED look). -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#47FFFFFF" />
            <stroke android:width="1dp" android:color="#8CFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3DFFFFFF" android:endColor="#17FFFFFF" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
